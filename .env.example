# Copy this file to .env for local development only.
# Never commit .env or use these example values.
ENVIRONMENT=development
DATABASE_URL=postgresql://user:password@localhost:5432/smartsched
SECRET_KEY=generate-a-random-value-at-least-32-characters-long
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$replace-with-a-bcrypt-hash
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
ENABLE_NGROK=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
